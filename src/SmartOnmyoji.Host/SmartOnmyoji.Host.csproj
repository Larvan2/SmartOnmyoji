<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = Windows GUI 子系统:发行版跑 `ui` 时不再弹黑色控制台窗口。
         控制台冒烟命令经 `dotnet run` 跑时,dotnet 重定向子进程 stdout 转发到终端,
         与子系统无关,输出照常可见(已实测)。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 可执行文件图标:沿用旧版 python-legacy/logo.ico -->
    <ApplicationIcon>..\..\python-legacy\logo.ico</ApplicationIcon>
    <!-- WebView2 桌面外壳需要 WinForms 宿主窗口 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WebView2 包同时带 WPF 包装(我们只用 WinForms),其 WindowsBase 版本冲突为良性,降为消息 -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!--
    P8:发行版(Release)以管理员运行(UIPI,见 app.manifest / 设计文档 §11)——启动即触发 UAC。
    仅 Release 声明:Debug 保持不提权,让 headless `serve`+curl / `list` / `match` 等
    "不触及游戏"的开发/验证命令免 UAC(对齐 CLAUDE.md);Debug 下跑触及游戏的命令用 `sudo`。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- 进程内起 Kestrel + SSE 事件流 + 静态 WebUI(见设计文档 §3/§10) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartOnmyoji.Core\SmartOnmyoji.Core.csproj" />
    <ProjectReference Include="..\SmartOnmyoji.Windows\SmartOnmyoji.Windows.csproj" />
    <ProjectReference Include="..\SmartOnmyoji.Vision\SmartOnmyoji.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <!--
    WebUI(..\SmartOnmyoji.WebUI,Vite + React):Vite 构建到它自己的 dist\,再作为 wwwroot\ 拷到输出目录,
    ContentRoot 固定为 BaseDirectory 后由 UseStaticFiles 提供。需要 PATH 里有 bun。
    Inputs/Outputs 做增量:前端源码没变就不重跑 Vite。只改后端时可 -p:SkipWebBuild=true 跳过(沿用上次的 dist\)。
  -->
  <PropertyGroup>
    <WebUIDir>$(MSBuildThisFileDirectory)..\SmartOnmyoji.WebUI\</WebUIDir>
  </PropertyGroup>
  <ItemGroup>
    <WebSource Include="$(WebUIDir)src\**\*;$(WebUIDir)index.html;$(WebUIDir)package.json;$(WebUIDir)bun.lock;$(WebUIDir)vite.config.ts;$(WebUIDir)tsconfig*.json;$(WebUIDir)components.json" />
  </ItemGroup>

  <Target Name="BuildWeb" BeforeTargets="BeforeBuild" Condition="'$(SkipWebBuild)' != 'true'"
          Inputs="@(WebSource)" Outputs="$(WebUIDir)dist\index.html">
    <Exec Command="bun --version" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_BunExitCode" />
    </Exec>
    <Error Condition="'$(_BunExitCode)' != '0'"
           Text="构建 WebUI 需要 bun(https://bun.sh),但 PATH 里找不到。装好后重试,或用 -p:SkipWebBuild=true 跳过前端构建。" />
    <Message Importance="high" Text="WebUI: bun run build …" />
    <Exec Command="bun install --frozen-lockfile" WorkingDirectory="$(WebUIDir)" />
    <Exec Command="bun run build" WorkingDirectory="$(WebUIDir)" />
    <!-- Vite 保留 index.html 的源文件时间戳时,输出会显得比输入旧,增量判断就永远认为过期。 -->
    <Touch Files="$(WebUIDir)dist\index.html" />
  </Target>

  <!--
    dist\ 的通配必须在 BuildWeb 之后再展开:写在顶层 ItemGroup 里会在求值阶段展开,
    那时干净 clone 的 dist\ 还不存在,第一次构建就会漏拷前端。
  -->
  <Target Name="IncludeWebContent" AfterTargets="BuildWeb" BeforeTargets="AssignTargetPaths">
    <!-- 分两步:target 内的 Include 里直接写 %(RecursiveDir) 会按别的项批处理,取到的不是本项的元数据。 -->
    <ItemGroup>
      <_WebDist Include="$(WebUIDir)dist\**\*" />
      <Content Include="@(_WebDist)" Link="wwwroot\%(_WebDist.RecursiveDir)%(_WebDist.Filename)%(_WebDist.Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    P8:发布后自动把仓库根 img\(目标集,已 gitignore)拷到发布目录 exe 旁,做到"开箱即用"。
    发行版的 exe 在自己所在目录找 img\(见 TargetSetCatalog.ResolveImgRoot),故拷到 $(PublishDir)img\。
    只在 publish 时跑(AfterTargets=Publish);img\ 不存在则跳过。img\ 是数据非二进制,不进单文件 exe。
  -->
  <Target Name="CopyImgToPublish" AfterTargets="Publish"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\img')">
    <ItemGroup>
      <_ImgFiles Include="$(MSBuildThisFileDirectory)..\..\img\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ImgFiles)"
          DestinationFiles="@(_ImgFiles->'$(PublishDir)img\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="[打包] 已复制仓库 img\ → $(PublishDir)img\" />
  </Target>

</Project>
