<?xml version="1.0" encoding="utf-8"?>
<!--
  P8 发行:自包含 · 单文件(win-x64)。干净机器无需装 .NET 运行时。
  用法:
    dotnet publish src/SmartOnmyoji.Host -p:PublishProfile=win-x64
  产物:仓库根 release/win-x64/SmartOnmyoji.Host.exe(单个 exe)。

  取舍说明:
  - SelfContained + PublishSingleFile:一个 exe 打包运行时 + 所有托管程序集。
  - IncludeNativeLibrariesForSelfExtract:OpenCvSharp 的 OpenCvSharpExtern、WebView2Loader
    等原生 dll 一并塞进 exe,启动时自解压到临时目录供加载(否则会散落在 exe 旁边)。
  - IncludeAllContentForSelfExtract:wwwroot 静态资源也随 exe 走(真·单文件分发);
    随之 AppContext.BaseDirectory 会指向自解压临时目录 —— 故 img/ 根改用真实 exe 同级解析
    (见 TargetSetCatalog.ResolveImgRoot),不受临时目录影响。
  - PublishTrimmed=false:OpenCvSharp/WinForms 大量反射,Trimming 有裁错风险,P8 先不开(待评估)。
  - Configuration=Release:随之启用 app.manifest 的 requireAdministrator(仅 Release 声明)。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <!-- 只拷 .dll 类关联文件(即不拷引用项目的 .pdb/.xml),发布目录保持单个 exe。 -->
    <AllowedReferenceRelatedFileExtensions>.dll</AllowedReferenceRelatedFileExtensions>
    <!-- 项目目录往上两级到仓库根,产物落到根目录的 release/ 而非埋在 bin\ 深处。 -->
    <PublishDir>..\..\release\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
